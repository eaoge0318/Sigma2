# ============================================
# Sigma2 環境設定
# 複製此檔為 .env 後修改
# ============================================

# LLM Server 設定
SIGMA_LLM_URL=http://10.10.20.214:8000/v1/chat/completions
SIGMA_LLM_MODEL=/models/gemma-3-27b-it-qat-compressed-tensors

# API Server 設定
SIGMA_API_PORT=8001

# ============================================
# 功能模組開關 (true=啟用, false=關閉)
# ============================================
SIGMA_FEATURE_FILES=true
SIGMA_FEATURE_CHARTS=true
SIGMA_FEATURE_DATA_ANALYSIS=true
SIGMA_FEATURE_MODEL_TRAINING=false
SIGMA_FEATURE_DASHBOARD=false
SIGMA_FEATURE_AI=false
